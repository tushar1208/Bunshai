# Production Custom Domain & Origins (Render)
CUSTOM_DOMAIN=
ENFORCE_CUSTOM_DOMAIN=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional Free-Tier Admin Bootstrap (used once during build.sh)
